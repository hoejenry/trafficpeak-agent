# Copy to .env and fill in values. .env is gitignored.

# --- Anthropic API (for chat) ---
# Get a key from https://platform.claude.com/settings/keys (requires Console org access).
ANTHROPIC_API_KEY=

# Optional: Akamai Foundry gateway, overrides ANTHROPIC_API_KEY above.
ANTHROPIC_FOUNDRY_API_KEY=
ANTHROPIC_FOUNDRY_BASE_URL=

# Optional: extra headers to send with Anthropic requests, e.g. "x-foo:bar,x-baz:qux"
ANTHROPIC_CUSTOM_HEADERS=

CLAUDE_MODEL=claude-sonnet-4-6

# --- TrafficPeak ---
TRAFFICPEAK_PORT=3001
TRAFFICPEAK_URL=
TRAFFICPEAK_TOKEN=
